{
  "expo": {
    "name": "Negroni",
    "slug": "negroni",
    "scheme": "negroni",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#050506"
        }
      ],
      "expo-router",
      "expo-apple-authentication",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Negroni uses the microphone to transcribe messages for your bots."
        }
      ],
      "expo-localization",
      "@react-native-vector-icons/ionicons",
      "@react-native-vector-icons/material-design-icons",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2965EC"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Negroni uses your photo library so you can attach images to a bot message.",
          "cameraPermission": "Negroni uses the camera so you can attach photos to a bot message.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "./plugins/with-worklets-headers"
    ],
    "ios": {
      "bundleIdentifier": "com.artempaskov.aisy",
      "usesAppleSignIn": true,
      "buildNumber": "25",
      "supportsTablet": true,
      "icon": "./assets/icon.png",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleIconName": "AppIcon",
        "NSCameraUsageDescription": "Negroni uses the camera so you can attach photos to a bot message.",
        "NSPhotoLibraryUsageDescription": "Negroni uses your photo library so you can attach images to a bot message.",
        "NSMicrophoneUsageDescription": "Negroni uses the microphone to transcribe messages for your bots.",
        "NSLocalNetworkUsageDescription": "Negroni connects to your Negroni server on the local network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.artempaskov.negroni",
      "versionCode": 10,
      "softwareKeyboardLayoutMode": "resize",
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#2965EC"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "supportsRTL": true
    },
    "updates": {
      "enabled": false
    }
  }
}
